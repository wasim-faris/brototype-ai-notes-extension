# Copy this file to .env to point a RELEASE build at the deployed backend.
# .env is gitignored. Leave it absent for local development (-> http://localhost:8787).
#
# The backend serves both the Notion sign-in and AI generation.
#   npm run build            -> development, localhost
#   npm run build:release    -> requires BACKEND_URL below (https:// only)
BACKEND_URL=https://your-service.onrender.com
