{
  "manifest_version": 3,
  "name": "Brototype AI Notes",
  "version": "1.2.0",
  "description": "Turns your Brototype task list into beginner-friendly study notes in your own Notion, with reviewer questions for every task.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "identity"
  ],
  "host_permissions": [
    "https://brototype.com/*",
    "https://*.brototype.com/*",
    "https://api.notion.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "app.html"
  },
  "action": {
    "default_title": "Brototype AI Notes \u2014 open the side panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "app.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
