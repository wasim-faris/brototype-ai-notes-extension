# Copy this file to .env for LOCAL development. .env is gitignored - never commit it.
# On Render, set the same names as environment variables in the dashboard
# (or via render.yaml's `sync: false` entries) - there is no .env file there.

# Local only. Render injects its own PORT; do not set it there.
PORT=8787

# --- AI provider (REQUIRED: at least one key) ----------------------------
# The extension never holds an AI key; every generation runs through here.
# OpenRouter is the recommended shared provider (one key, many models).
#   https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Optional: which model to spend the key on. Default: the extension's
# registry default for the provider (a ":free" OpenRouter model).
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Other providers work the same way: set the key, optionally the model.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# CLAUDE_API_KEY=
# GROK_API_KEY=
# CUSTOM_API_KEY=
# CUSTOM_BASE_URL=
# CUSTOM_MODEL=

# Which provider serves requests that do not name one (the normal case).
# Defaults to the first provider above that has a key.
DEFAULT_PROVIDER=openrouter

# --- Notion OAuth (REQUIRED) ---------------------------------------------
# From your PUBLIC integration at https://www.notion.so/my-integrations
# The client secret lives here and nowhere else - never in the extension.
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
# The extension's own redirect URL. It is fixed by the `key` in
# extension/manifest.json, so it is the same for every user and every build:
#   https://<extension-id>.chromiumapp.org/notion
# The extension shows the exact value under Notion -> Advanced. Register it
# byte-for-byte in the integration's "Redirect URIs" and paste it here.
NOTION_OAUTH_REDIRECT_URI=

# --- Production hardening (set these on Render) -----------------------------
# Comma-separated extension id(s) allowed to call this server from a browser.
# Leave empty in development so an unpacked build with any id works.
ALLOWED_EXTENSION_IDS=
# NODE_ENV=production hides developer `detail` fields from API error responses.
# NODE_ENV=production

# --- Optional tuning ---------------------------------------------------------
# RATE_LIMIT_PER_MINUTE=30      requests per client IP per minute
# AI_TIMEOUT_MS=180000          how long one generation may take upstream
